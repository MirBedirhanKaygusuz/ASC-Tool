{
  "name": "greenlight",
  "version": "0.1.0",
  "private": true,
  "description": "Store Policy Checker — App Store / Google Play listing denetimi",
  "type": "module",
  "scripts": {
    "check": "tsx src/cli.ts check",
    "corpus": "tsx src/cli.ts corpus",
    "typecheck": "tsc --noEmit",
    "dbg": "tsx scripts/dbg.ts",
    "dbg:verify": "tsx scripts/dbg-verify.ts",
    "learn": "tsx src/cli.ts learn",
    "lessons": "tsx src/cli.ts lessons",
    "asc:copy": "pbcopy < scripts/asc-grab.js && echo \"snippet panoda — ASC sekmesinde DevTools Console'a yapistir\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@supabase/supabase-js": "^2.112.3",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
