# havuz/.env — bu dosyayı .env olarak kopyala ve doldur. .env git'e GİRMEZ.

# --- Veritabanı ------------------------------------------------------------
POSTGRES_DB=greenlight
POSTGRES_USER=greenlight
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Belirteçler -----------------------------------------------------------
# İKİSİ DE ZORUNLU ve FARKLI olmalı. Sunucu aksi hâlde açılmaz.
#
#   okuma → ofisteki herkeste (eklenti ayarlarında, CLI'da). Dersleri ve red
#           örneklerini görür VE ders onaylayıp emekliye ayırabilir. Arşive
#           içerik EKLEYEMEZ, var olanı EZEMEZ.
#   yazma → yalnız red metinlerini işleyen kişide (npm run learn).
#
# Ayrım şundan: okuma belirteci eklentinin ayarlarında duruyor, yani "sır"
# sayılamaz — makinesine erişen herkes görebilir. Onay bilerek ona açık (ekip
# işi; kapalıyken havuz öğrenmiyor) ama ders/vaka/vektör yazmak kapalı: sızan
# bir belirteç geri alınabilir bir durum değişikliği yapabilir, kayıp veri
# üretemez. Kısmak için: havuz/router.js içindeki PATCH satırını
# YAZMA_YOLLARI'na taşı.
#
# openssl rand -hex 32
HAVUZ_READ_TOKEN=
HAVUZ_WRITE_TOKEN=

# --- Ağ --------------------------------------------------------------------
HAVUZ_PORT=8787
# 127.0.0.1 → yalnız sunucunun kendisi. Başka makinelerden erişilecekse
# docker-compose.tls.yml katmanını kullan (Caddy önde, api dışarı açılmaz).
# 0.0.0.0 yapıp TLS'siz açmak belirteci ağda açık gönderir.
HAVUZ_BIND=127.0.0.1

# --- TLS ---------------------------------------------------------------
# docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
# HAVUZ_DOMAIN=havuz.sirketin.com
# HAVUZ_EMAIL=sen@sirketin.com
