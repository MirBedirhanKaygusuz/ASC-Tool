# --- LLM (varsayılan: yerel) ---------------------------------------------
GREENLIGHT_LLM=ollama

# Yerel model. M1 Pro / 16GB için makul seçenekler:
#   qwen3:8b       ~5 GB  — varsayılan, iyi JSON + talimat takibi
#   qwen2.5:14b    ~9 GB  — daha güçlü, belirgin yavaş
#   gemma3:12b     ~8 GB  — vision de var (ekran görüntüsü denetimi için)
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# KRİTİK: submission ~15-20K token. Bu değer düşükse Ollama fazlasını
# SESSİZCE keser ve kuralın baktığı metnin yarısı modele hiç ulaşmaz.
OLLAMA_NUM_CTX=32768

# Görsel denetimi sadece vision destekleyen modelde aç (gemma3, qwen2.5vl).
OLLAMA_VISION=0

# Qwen3 "thinking" modu — kaliteyi artırır, hızı ciddi düşürür.
OLLAMA_THINK=0

# --- Bulut (opsiyonel) ---------------------------------------------------
# Sadece iki iş için: (1) vision, (2) "yerel model ne kaybettiriyor" ölçümü.
# Boş bırakılırsa hiç devreye girmez.
ANTHROPIC_API_KEY=
GREENLIGHT_CLOUD_MODEL=claude-opus-5

# --- Mağaza API'leri (Faz 1) --------------------------------------------
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=./AuthKey_XXXX.p8
GOOGLE_SERVICE_ACCOUNT_JSON=./play-service-account.json

# --- freellmapi / OpenAI-uyumlu uç nokta --------------------------------
# Geliştirme sürecinde freellmapi, üretimde ücretli API — aynı sağlayıcı,
# sadece bu üç değer değişir. Kod değişmez.
#
#   kurulum: curl -fsSL https://freellmapi.co/install.sh | bash
#   sonra dashboard'dan sağlayıcı anahtarlarını ekle
#
# GREENLIGHT_LLM=freellmapi
# OPENAI_BASE_URL=http://localhost:3001/v1
# OPENAI_API_KEY=freellmapi-...
# OPENAI_MODEL=llama-3.3-70b
# OPENAI_CONCURRENCY=4
# OPENAI_VISION=0          # vision destekleyen modelde 1 yap
# OPENAI_STRICT_SCHEMA=0   # uç nokta katı json_schema destekliyorsa 1

# --- Ders deposu ---------------------------------------------------------
# Varsayılan yerel dosya sistemi: lessons/index.json + lessons/bodies + rejects
# Havuz kurulmadan da tüm öğrenme akışı çalışır.
GREENLIGHT_STORE=local
LESSONS_DIR=lessons

# --- Ortak ders havuzuna geçiş — sadece bu üç satır ----------------------
# NE DEĞİŞİR: dersler ve red vakaları artık bu makinede değil, ofisin ortak
# sunucusunda. Ahmet'in işlediği red'i Ayşe'nin denetimi de kullanır
# (belkiPatlarız R10). Kod değişmez — LessonStore arayüzü ikisini de karşılıyor.
#
# Kurulum (Docker + Postgres, kendi sunucunda): havuz/README.md
# Eldeki dersleri taşımak: npm run lessons -- push
#
# BELİRTEÇ SEÇİMİ ÖNEMLİ: terminalde `learn` ders AÇIYOR, yani YAZMA belirteci
# gerekli. Eklentiye ise OKUMA belirteci giriliyor — orası havuzu değiştirmez.
# GREENLIGHT_STORE=havuz
# HAVUZ_URL=https://havuz.sirketin.com
# HAVUZ_TOKEN=

# --- Ders eşleştirme: anlamsal arama (Voyage AI) -------------------------
# NE İŞE YARIYOR: yeni bir red geldiğinde, mevcut dersler arasında aday
# ararken madde numarası eşleşmesi TEK BAŞINA yetmiyor. Aynı kalıp bir
# reviewer'da "2.3.3", başkasında "2.3.1" diye yazılınca aday bulunamıyor ve
# mevcut dersin örneği olacak vaka KOPYA DERS açıyor.
#
# Anahtar boşsa özellik kapalıdır ve boru hattı eskisi gibi çalışır —
# yalnızca numara eşleşmesiyle. Hiçbir şey bozulmaz.
#
# MALİYET: voyage-4-lite 1M token başına $0.02 ve 200M token ücretsiz kota
# var. Bu ölçekte pratikte ücretsiz: bir ders ~50 token, bir reindex birkaç
# bin token. Anahtar: https://dashboard.voyageai.com
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4-lite
# VOYAGE_DIM=512
# Aday sayılmak için gereken en düşük kosinüs benzerliği. Yükseltmek kaçırır,
# düşürmek eşleştirme prompt'unu çöple doldurur — kararı zaten model veriyor.
# LESSON_MATCH_MIN=0.55
# LESSON_MATCH_TOPK=5

# --- Ders çıkarımı: ikinci tur -------------------------------------------
# auto   (varsayılan) bedava kontroller şüphe bulursa modele YALNIZCA şüpheli
#        alanları yeniden sorar. Temiz bir red metninde ek maliyet sıfır.
# always şüphe olmasa da scope/summary/signals'ı gözden geçirir. Red metni
#        toplu yükleniyorsa ve doğruluk hızdan önemliyse.
# off    ikinci tur yok. Bedava kontroller yine koşar; ham metinde
#        bulunamayan alıntı yine silinir.
# LESSON_REVIEW=auto
