# --- LLM (varsayılan: yerel) ---------------------------------------------
GREENLIGHT_LLM=ollama

# Yerel model. M1 Pro / 16GB için makul seçenekler:
#   qwen3:8b       ~5 GB  — varsayılan, iyi JSON + talimat takibi
#   qwen2.5:14b    ~9 GB  — daha güçlü, belirgin yavaş
#   gemma3:12b     ~8 GB  — vision de var (ekran görüntüsü denetimi için)
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# KRİTİK: submission ~15-20K token. Bu değer düşükse Ollama fazlasını
# SESSİZCE keser ve kuralın baktığı metnin yarısı modele hiç ulaşmaz.
OLLAMA_NUM_CTX=32768

# Görsel denetimi sadece vision destekleyen modelde aç (gemma3, qwen2.5vl).
OLLAMA_VISION=0

# Qwen3 "thinking" modu — kaliteyi artırır, hızı ciddi düşürür.
OLLAMA_THINK=0

# --- Bulut (opsiyonel) ---------------------------------------------------
# Sadece iki iş için: (1) vision, (2) "yerel model ne kaybettiriyor" ölçümü.
# Boş bırakılırsa hiç devreye girmez.
ANTHROPIC_API_KEY=
GREENLIGHT_CLOUD_MODEL=claude-opus-5

# --- Mağaza API'leri (Faz 1) --------------------------------------------
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=./AuthKey_XXXX.p8
GOOGLE_SERVICE_ACCOUNT_JSON=./play-service-account.json

# --- freellmapi / OpenAI-uyumlu uç nokta --------------------------------
# Geliştirme sürecinde freellmapi, üretimde ücretli API — aynı sağlayıcı,
# sadece bu üç değer değişir. Kod değişmez.
#
#   kurulum: curl -fsSL https://freellmapi.co/install.sh | bash
#   sonra dashboard'dan sağlayıcı anahtarlarını ekle
#
# GREENLIGHT_LLM=freellmapi
# OPENAI_BASE_URL=http://localhost:3001/v1
# OPENAI_API_KEY=freellmapi-...
# OPENAI_MODEL=llama-3.3-70b
# OPENAI_CONCURRENCY=4
# OPENAI_VISION=0          # vision destekleyen modelde 1 yap
# OPENAI_STRICT_SCHEMA=0   # uç nokta katı json_schema destekliyorsa 1

# --- Ders deposu ---------------------------------------------------------
# Varsayılan yerel dosya sistemi: lessons/index.json + lessons/bodies + rejects
# Bulut anahtarları olmadan tüm öğrenme akışı çalışır.
GREENLIGHT_STORE=local
LESSONS_DIR=lessons

# Buluta geçiş — sadece bu satırlar. Kod değişmez.
# Şema: sql/lessons.sql
# GREENLIGHT_STORE=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# R2_BUCKET=greenlight-lessons
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
