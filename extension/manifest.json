{
  "manifest_version": 3,
  "name": "Greenlight — App Store Connect toplayıcı",
  "version": "0.19.0",
  "description": "App Store Connect verisini tarayıcı oturumuyla çeker ve denetler. Anahtar yok, snippet yok, terminal yok.",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://appstoreconnect.apple.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Greenlight",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "key": ""
}
